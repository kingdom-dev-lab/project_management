{
  "name": "asana-like-saas",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "migrate": "npx prisma db push --schema backend/prisma/schema.prisma",
    "install:app": "npm run install:app --workspace backend",
    "test": "npm run test --workspace backend",
    "one-click": "sh ./start.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "^6.2.1"
  }
}
